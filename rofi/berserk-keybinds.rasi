/**
 * BERSERK CYBERPUNK - ROFI KEYBINDS THEME
 * Diseñado para Dotfiles DevOps / Berserk Edition
 **/

* {
    font:                        "JetBrainsMono Nerd Font 11";
    bg-dark:                     #0a0a0ce6;
    bg-card:                     #12121ae6;
    bg-selected:                 #ff2a3a24;
    bg-input:                    #14141ee8;
    border-red:                  #ff2a3a;
    border-glow:                 #ff2a3a55;
    red-berserk:                 #ff2a3a;
    cyan-cyber:                  #00f0ff;
    fg-main:                     #f0f0f5;
    fg-dim:                      #888899;
    fg-selected:                 #ffffff;

    background-color:            transparent;
    text-color:                  @fg-main;
    margin:                      0px;
    padding:                     0px;
    spacing:                     0px;
}

window {
    background-color:            @bg-dark;
    border:                      2px solid;
    border-color:                @border-red;
    border-radius:               12px;
    width:                       920px;
    padding:                     24px;
    location:                    center;
    anchor:                      center;
}

mainbox {
    enabled:                     true;
    orientation:                 vertical;
    spacing:                     16px;
    children:                    [ "inputbar", "listview" ];
}

inputbar {
    enabled:                     true;
    spacing:                     12px;
    padding:                     8px 12px;
    border:                      1px solid;
    border-color:                @border-glow;
    border-radius:               8px;
    background-color:            @bg-input;
    text-color:                  @fg-main;
    children:                    [ "prompt", "entry" ];
}

prompt {
    enabled:                     true;
    padding:                     4px 12px;
    border-radius:               6px;
    background-color:            @red-berserk;
    text-color:                  #0a0a0c;
    font:                        "JetBrainsMono Nerd Font Bold 11";
}

entry {
    enabled:                     true;
    padding:                     4px 8px;
    text-color:                  @fg-main;
    placeholder:                 "Escribe para buscar un atajo (ej. spotube, cerrar, foco)...";
    placeholder-color:           @fg-dim;
    cursor:                      text;
}

listview {
    enabled:                     true;
    columns:                     1;
    lines:                       19;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   true;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;
    spacing:                     4px;
    padding:                     4px 0px;
    border:                      0px;
}

scrollbar {
    handle-width:                4px;
    handle-color:                @red-berserk;
    border-radius:               4px;
    background-color:            #1a1a24;
}

element {
    enabled:                     true;
    spacing:                     10px;
    padding:                     8px 12px;
    border-radius:               6px;
    background-color:            transparent;
    text-color:                  @fg-main;
    cursor:                      pointer;
}

element normal.normal {
    background-color:            transparent;
    text-color:                  @fg-main;
}

element selected.normal {
    background-color:            @bg-selected;
    text-color:                  @fg-selected;
    border:                      1px solid;
    border-color:                @red-berserk;
}

element-text {
    background-color:            transparent;
    text-color:                  inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}

element-icon {
    background-color:            transparent;
    size:                        20px;
    cursor:                      inherit;
}
