/**
 * BERSERK CYBERPUNK - DEFAULT ROFI CONFIG
 * Configuración maestra para lanzador de aplicaciones (SUPER + R)
 **/

configuration {
    modi:                        "drun,run,window";
    show-icons:                  true;
    display-drun:                "󰀻 APPS";
    display-run:                 "󰌨 RUN";
    display-window:              "󰕰 VENTANAS";
    drun-display-format:         "{name}";
    window-format:               "{w} · {c} · {t}";
    font:                        "JetBrainsMono Nerd Font 11";
}

* {
    bg-dark:                     #0a0a0cf0;
    bg-input:                    #14141ee8;
    bg-selected:                 #ff2a3a28;
    red-berserk:                 #ff2a3a;
    border-glow:                 #ff2a3a55;
    fg-main:                     #f0f0f5;
    fg-dim:                      #888899;
    fg-selected:                 #ffffff;

    background-color:            transparent;
    text-color:                  @fg-main;
}

window {
    background-color:            @bg-dark;
    border:                      2px solid;
    border-color:                @red-berserk;
    border-radius:               12px;
    width:                       680px;
    padding:                     20px;
    location:                    center;
    anchor:                      center;
}

mainbox {
    orientation:                 vertical;
    spacing:                     14px;
    children:                    [ "inputbar", "listview" ];
}

inputbar {
    spacing:                     12px;
    padding:                     8px 12px;
    border:                      1px solid;
    border-color:                @border-glow;
    border-radius:               8px;
    background-color:            @bg-input;
    text-color:                  @fg-main;
    children:                    [ "prompt", "entry" ];
}

prompt {
    padding:                     4px 12px;
    border-radius:               6px;
    background-color:            @red-berserk;
    text-color:                  #0a0a0c;
    font:                        "JetBrainsMono Nerd Font Bold 11";
}

entry {
    padding:                     4px 8px;
    text-color:                  @fg-main;
    placeholder:                 "Buscar aplicaciones...";
    placeholder-color:           @fg-dim;
}

listview {
    columns:                     2;
    lines:                       8;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    spacing:                     6px;
    padding:                     4px 0px;
}

element {
    spacing:                     12px;
    padding:                     8px 12px;
    border-radius:               6px;
    background-color:            transparent;
    text-color:                  @fg-main;
    cursor:                      pointer;
}

element selected.normal {
    background-color:            @bg-selected;
    text-color:                  @fg-selected;
    border:                      1px solid;
    border-color:                @red-berserk;
}

element-text {
    background-color:            transparent;
    text-color:                  inherit;
    vertical-align:              0.5;
}

element-icon {
    background-color:            transparent;
    size:                        28px;
}
