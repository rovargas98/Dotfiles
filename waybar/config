{
  "layer": "top",
  "position": "top",
  "margin-top": 8,
  "margin-left": 14,
  "margin-right": 14,
  "spacing": 0,
  
  "modules-left": [
    "hyprland/workspaces",
    "hyprland/window"
  ],
  "modules-center": [
    "mpris"
  ],
  "modules-right": [
    "tray",
    "pulseaudio",
    "network",
    "disk",
    "memory",
    "custom/cpu_telemetry",
    "custom/gpu_telemetry",
    "clock",
    "custom/control_center",
    "custom/power"
  ],

  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "on-click": "activate",
    "format": "{icon}",
    "format-icons": {
      "1": "",
      "2": "󰈹",
      "3": "",
      "4": "󰎈",
      "5": "󰙯",
      "urgent": "",
      "active": "",
      "default": ""
    }
  },

  "hyprland/window": {
    "format": "󰣆 {title}",
    "max-length": 35,
    "rewrite": {
      "^$": "󰣆 CyberDeck // rocachyos"
    },
    "separate-outputs": true
  },

  "mpris": {
    "format": "{player_icon}  {title} - {artist}",
    "format-paused": "󰏤  <i>{title} - {artist}</i>",
    "player-icons": {
      "default": "󰎈",
      "spotube": "󰠃",
      "spotify": ""
    },
    "max-length": 42,
    "on-click": "play-pause",
    "on-scroll-up": "next",
    "on-scroll-down": "previous"
  },

  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "  Muted",
    "format-icons": {
      "default": ["", "", ""]
    },
    "on-click": "pavucontrol",
    "on-click-right": "~/Dotfiles/waybar/scripts/audio-switch.sh",
    "scroll-step": 5
  },

  "network": {
    "interval": 5,
    "format-wifi": "  {essid}",
    "format-ethernet": "󰈀  LAN",
    "format-disconnected": "󰖪  Offline",
    "tooltip-format": "Red: {essid} ({signalStrength}%)\nInterfaz: {ifname}\nIP: {ipaddr}\nGateway: {gwaddr}\nVelocidad: ⇣ {bandwidthDownBytes}  ⇡ {bandwidthUpBytes}",
    "max-length": 22
  },

  "disk": {
    "interval": 30,
    "format": "  {percentage_used}%",
    "tooltip-format": "INFORME DE DISCO:\nTotal: {total}\nUsado: {used}\nLibre: {free}\nRuta: {path}"
  },

  "memory": {
    "interval": 5,
    "format": "  {percentage}%",
    "tooltip-format": "INFORME DE RAM:\nTotal: {total:0.1f}GB\nUsado: {used:0.1f}GB\nDisponible: {avail:0.1f}GB\nSwap Usado: {swapUsed:0.1f}GB",
    "on-click": "kitty -e btop"
  },

  "custom/cpu_telemetry": {
    "exec": "~/Dotfiles/waybar/scripts/cpu-telemetry.sh",
    "return-type": "json",
    "interval": 2,
    "on-click": "kitty -e btop"
  },

  "custom/gpu_telemetry": {
    "exec": "~/Dotfiles/waybar/scripts/gpu-telemetry.sh",
    "return-type": "json",
    "interval": 2,
    "on-click": "kitty -e btop"
  },

  "clock": {
    "interval": 1,
    "format": " {:%H:%M:%S   %d/%m}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#ffead3'><b>{}</b></span>",
        "days": "<span color='#c0caf5'>{}</span>",
        "today": "<span color='#ff2a3a'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },

  "tray": {
    "icon-size": 15,
    "spacing": 8
  },

  "custom/control_center": {
    "format": "󱄄",
    "tooltip": true,
    "tooltip-format": "Centro de Control Eww [SUPER + A]",
    "on-click": "eww open --toggle command-center-win"
  },

  "custom/power": {
    "format": "",
    "tooltip": true,
    "tooltip-format": "Cerrar sesión / Apagar (hyprshutdown)",
    "on-click": "hyprshutdown"
  }
}
